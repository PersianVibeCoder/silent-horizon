+		// Quiet Glass is rendered inside a padded surface: the feathered corner
+		// light stays inside the dock window even while its width is animated.
+		public bool is_quiet_glass ()
+		{
+			return theme_folder != null && theme_folder.get_basename () == "Quiet-Glass";
+		}
+
+		void quiet_glass_path (Cairo.Context cr, double x, double y, double w, double h, double r)
+		{
+			draw_rounded_rect (cr, x, y, w, h, r, r, 1.0);
+		}
+
+		void quiet_glass_corner (Cairo.Context cr, double x, double y, double w, double h, double r, bool first)
+		{
+			double cx = first ? x + 0.30 * r : x + w - 0.30 * r;
+			double cy = first ? y + 0.30 * r : y + h - 0.30 * r;
+			double spread = double.min (44.0, h * 0.61);
+			// A soft inner reflection, clipped only to the actual glass shape.
+			cr.save ();
+			quiet_glass_path (cr, x, y, w, h, r);
+			cr.clip ();
+			var inner = new Cairo.Pattern.radial (cx, cy, 0, cx, cy, spread);
+			inner.add_color_stop_rgba (0, 0.78, 0.89, 0.96, 0.42);
+			inner.add_color_stop_rgba (0.25, 0.61, 0.77, 0.88, 0.19);
+			inner.add_color_stop_rgba (0.60, 0.44, 0.62, 0.78, 0.065);
+			inner.add_color_stop_rgba (1, 0.44, 0.62, 0.78, 0);
+			cr.set_source (inner);
+			cr.paint ();
+			cr.restore ();
+			// Concentric strokes form a smooth halo with no rectangular cutoff.
+			double[] widths = { 16, 11, 7, 4, 2.2, 1.05 };
+			double[] strengths = { 0.025, 0.035, 0.065, 0.14, 0.32, 0.94 };
+			for (int i = 0; i < widths.length; i++) {
+				var rim = new Cairo.Pattern.radial (cx, cy, 0, cx, cy, spread);
+				rim.add_color_stop_rgba (0, 0.91, 0.98, 1, strengths[i]);
+				rim.add_color_stop_rgba (0.26, 0.79, 0.92, 1, strengths[i] * 0.80);
+				rim.add_color_stop_rgba (0.65, 0.63, 0.79, 0.91, strengths[i] * 0.15);
+				rim.add_color_stop_rgba (1, 0.63, 0.79, 0.91, 0);
+				quiet_glass_path (cr, x, y, w, h, r);
+				cr.set_source (rim);
+				cr.set_line_width (widths[i]);
+				cr.stroke ();
+			}
+		}
+
+		void draw_quiet_glass (Surface surface)
