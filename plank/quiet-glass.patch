+			cr.set_source_rgba (OuterStrokeColor.red, OuterStrokeColor.green, OuterStrokeColor.blue, OuterStrokeColor.alpha);
+			cr.stroke ();
+			quiet_glass_corner (cr, x, y, w, h, radius, true);
+			quiet_glass_corner (cr, x, y, w, h, radius, false);
+			cr.restore ();
+		}
